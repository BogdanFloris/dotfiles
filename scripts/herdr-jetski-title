#!/usr/bin/env python3
# Jetski title command: stdout becomes the pane title, and agent state is
# reported to herdr. Wired in ~/.gemini/jetski/cli/settings.json as title.command.
import codecs
import json
import os
import random
import re
import socket
import subprocess
import sys
import time

ANNOTATIONS_DIR = os.path.expanduser("~/.gemini/jetski/annotations")


# The CLI only loads conversation_title when it starts streaming a conversation,
# so new conversations never get it; the generated title lands in annotations.
def annotation_title(conversation_id):
    if not conversation_id:
        return ""
    try:
        with open(os.path.join(ANNOTATIONS_DIR, f"{conversation_id}.pbtxt"), "rb") as f:
            m = re.search(rb'(?<!\w)title:\s*"((?:[^"\\]|\\.)*)"', f.read())
    except OSError:
        return ""
    return codecs.escape_decode(m.group(1))[0].decode("utf-8", "replace") if m else ""


def get_herdr_path():
    try:
        res = subprocess.run(["which", "herdr"], capture_output=True, text=True)
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass

    user = os.environ.get("USER", "")
    paths = [
        f"/usr/local/google/home/{user}/.local/bin/herdr",
        f"/usr/local/google/home/{user}/homebrew/bin/herdr",
        "/opt/homebrew/bin/herdr",
        "/usr/local/bin/herdr",
        "/usr/bin/herdr",
    ]
    for p in paths:
        if os.path.exists(p):
            return p
    return "herdr"


def socket_request(socket_path, method, params):
    request = {
        "id": f"custom:jetski:{int(time.time() * 1000)}:{random.randrange(1_000_000):06d}",
        "method": method,
        "params": params,
    }
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(0.5)
    client.connect(socket_path)
    client.sendall((json.dumps(request) + "\n").encode())
    try:
        client.recv(4096)
    except Exception:
        pass
    client.close()


def report_via_socket(socket_path, pane_id, state, message, session_id):
    params = {
        "pane_id": pane_id,
        "source": "custom:jetski",
        "agent": "jetski",
        "state": state,
        "message": message,
        "seq": time.time_ns(),
    }
    if session_id:
        params["agent_session_id"] = session_id
    socket_request(socket_path, "pane.report_agent", params)


# OSC titles from jetski don't reach the herdr sidebar; metadata title does
def report_title_via_socket(socket_path, pane_id, title):
    socket_request(socket_path, "pane.report_metadata", {
        "pane_id": pane_id,
        "source": "custom:jetski-title",
        "agent": "jetski",
        "title": title,
        "seq": time.time_ns(),
    })


def report_via_cli(pane_id, state, message, session_id):
    herdr_bin = get_herdr_path()
    cmd = [
        herdr_bin,
        "pane",
        "report-agent",
        pane_id,
        "--agent",
        "jetski",
        "--source",
        "custom:jetski",
        "--state",
        state,
        "--message",
        message,
        "--seq",
        str(time.time_ns()),
    ]
    if session_id:
        cmd.extend(["--agent-session-id", str(session_id)])

    subprocess.run(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
        check=False,
    )


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        return

    session_id = data.get("conversation_id") or data.get("session_id")
    title = data.get("conversation_title") or annotation_title(session_id)
    title = " ".join(str(title or "").split()) or "jetski"
    print(title, flush=True)

    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        return

    is_blocked = bool(data.get("tool_confirmation_pending"))
    agent_state = str(data.get("agent_state") or "").lower()

    # jetski agent_state: idle|working|tool_use|reviewing|authenticating|initializing|error
    # anything the user has to act on must map to idle/blocked, never working
    if is_blocked:
        state, message = "blocked", "Waiting for permission..."
    elif agent_state == "authenticating":
        state, message = "blocked", "Waiting for auth..."
    elif agent_state == "idle":
        state, message = "idle", "Ready"
    elif agent_state == "reviewing":
        state, message = "idle", "Review pending"
    elif agent_state == "error":
        state, message = "idle", "Error"
    elif agent_state == "tool_use":
        state, message = "working", "Running tool..."
    elif agent_state == "initializing":
        state, message = "working", "Initializing..."
    else:
        state, message = "working", "Working..."

    socket_path = os.environ.get("HERDR_SOCKET_PATH")
    reported = False
    if socket_path and os.path.exists(socket_path):
        try:
            report_via_socket(socket_path, pane_id, state, message, session_id)
            reported = True
        except Exception:
            reported = False

    if not reported:
        try:
            report_via_cli(pane_id, state, message, session_id)
        except Exception:
            pass

    if socket_path and os.path.exists(socket_path):
        try:
            report_title_via_socket(socket_path, pane_id, title)
        except Exception:
            pass


if __name__ == "__main__":
    main()
