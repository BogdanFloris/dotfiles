#!/usr/bin/env bash
# gnome-profile - keep gnome_profile.dconf in sync with the live dconf database.
#
# GNOME settings live in dconf, which nothing in this repo applies automatically;
# gnome_profile.dconf is a snapshot that has to be refreshed by hand. Use this
# instead of `dconf dump /` so the committed file stays free of window geometry,
# last-used paths and other per-machine noise (this repo is public).
#
#   scripts/gnome-profile dump    refresh gnome_profile.dconf from the live database
#   scripts/gnome-profile load    apply gnome_profile.dconf to the live database
#   scripts/gnome-profile diff    show what drifted since the last dump
#
# `load` merges - it writes the keys in the file and leaves everything else
# alone, so it never resets a setting the snapshot doesn't mention.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile="$repo_root/gnome_profile.dconf"

# Whole sections that only ever hold volatile or machine-local state.
skip_sections=(
  'com/mattjakeman/ExtensionManager'
  'org/gnome/Extensions'
  'org/gnome/control-center'
  'org/gnome/epiphany/state'
  'org/gnome/nautilus/window-state'
  'org/gnome/portal/filechooser/'
  'org/gnome/settings-daemon/plugins/housekeeping'
  'org/gnome/desktop/app-folders/folders/Pardus'
  'org/gnome/desktop/app-folders/folders/YaST'
)

# Individual keys, matched in any section.
skip_keys=(
  window-size window-width window-height window-maximized window-state
  window-position is-maximized is-fullscreen
  initial-size initial-size-file-chooser
  last-folder-path last-panel
  night-light-last-coordinates
  app-picker-layout
  welcome-dialog-last-shown-version
  recently-installed-apps update-notifier-project-version prefs-visible-page
)

# Filters a dconf dump on stdin: drops the lists above, then drops any section
# left with no keys.
filter_dump() {
  awk -v sections="${skip_sections[*]}" -v keys="${skip_keys[*]}" '
    BEGIN {
      split(sections, s, " "); for (i in s) skip_section[s[i]] = 1
      split(keys, k, " ");     for (i in k) skip_key[k[i]] = 1
    }
    function flush_section() {
      if (header != "" && nbuf > 0) {
        if (printed) print ""
        print header
        for (i = 1; i <= nbuf; i++) print buf[i]
        printed = 1
      }
      nbuf = 0
    }
    /^\[/ {
      flush_section()
      header = $0
      path = substr($0, 2, length($0) - 2)
      dropped = 0
      for (p in skip_section)
        if (index(path, p) == 1) dropped = 1
      next
    }
    /^[^=]+=/ {
      if (dropped) next
      key = substr($0, 1, index($0, "=") - 1)
      if (key in skip_key) next
      buf[++nbuf] = $0
      next
    }
    END { flush_section() }
  '
}

generate() {
  printf '# Snapshot of user GNOME settings, generated by scripts/gnome-profile dump.\n'
  printf '# Apply with `scripts/gnome-profile load`; nothing applies it automatically.\n\n'
  dconf dump / | filter_dump
}

case "${1:-}" in
  dump)
    generate > "$profile"
    printf 'wrote %s (%s keys)\n' "$profile" "$(grep -c '^[^#[]*=' "$profile")"
    ;;
  load)
    dconf load / < "$profile"
    printf 'loaded %s\n' "$profile"
    ;;
  diff)
    if generate | diff -u --label "$profile" "$profile" --label 'live dconf' -; then
      printf 'no drift\n'
    fi
    ;;
  *)
    printf 'usage: %s {dump|load|diff}\n' "${0##*/}" >&2
    exit 1
    ;;
esac
