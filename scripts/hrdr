#!/usr/bin/env bash
# hrdr - Herdr wrapper with SSH/gnubby agent socket forwarding (similar to tmx2/scrn)
set -e

function link_or_rm() {
  local env="$1"
  local tmp="$2"
  if [ -z "${env}" ]; then
    # No auth sock; remove symlink, if any.
    rm -f -- "${tmp}"
  elif ! [ "${env}" -ef "${tmp}" ]; then
    # Construct expected symlink to point to auth sock.
    ln -snf -- "${env}" "${tmp}"
  fi
}

# Find the actual herdr binary (avoid infinite recursion if aliased or symlinked as herdr)
function get_herdr_bin() {
  local self_path
  self_path=$(realpath "$0" 2>/dev/null || echo "$0")
  local bin
  for bin in $(type -a -p herdr 2>/dev/null); do
    if [ "$(realpath "$bin" 2>/dev/null)" != "$self_path" ]; then
      echo "$bin"
      return
    fi
  done
  echo "herdr"
}

HERDR_BIN=$(get_herdr_bin)

# Ensure ~/.tmp exists
d="${HOME}/.tmp"
if ! [ -d "${d}" ]; then
  mkdir -m 700 "${d}"
fi

if [ -z "${HERDR_ENV}" ]; then
  # Outside Herdr: refresh the static symlink to point to the current SSH_AUTH_SOCK
  s=".${USER}.ssh_auth_sock"
  t=".${USER}.fwd_ssh_auth_sock"
  link_or_rm "${SSH_AUTH_SOCK}" "${d}/${s}"
  link_or_rm "${FWD_SSH_AUTH_SOCK}" "${d}/${t}"

  f="FWD_SSH_AUTH_SOCK=${d}/${t}"
  if [ -z "${FWD_SSH_AUTH_SOCK}" ]; then
    f=""
  fi

  exec env SSH_AUTH_SOCK="${d}/${s}" ${f} "${HERDR_BIN}" "$@"
else
  # Already inside a Herdr pane: run herdr normally
  exec "${HERDR_BIN}" "$@"
fi
