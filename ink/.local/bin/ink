#!/usr/bin/env bash
# Opens a draft in the writing room: Neovim in writing mode, in the current terminal.
# Usage: ink [file]   (no file: the most recently edited draft in $INK_DIR, default ~/writing)
set -euo pipefail

drafts="${INK_DIR:-$HOME/writing}"

if [[ $# -gt 0 ]]; then
	file="$1"
else
	mkdir -p "$drafts"
	file="$(ls -t "$drafts"/*.md 2>/dev/null | head -n 1 || true)"
	file="${file:-$drafts/$(date +%F).md}"
fi

INK_WRITING=1 exec nvim -- "$file"
